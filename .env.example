# ==============================================================================
# Variáveis de Ambiente - Personal Assistant (Clone Digital)
# Copie este arquivo para .env e preencha com as suas configurações locais
# ==============================================================================

# Configurações do Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_MODEL=llama3.2

# Configurações de Identidade do Clone
CLONE_NAME="Yan Chagas"
SYSTEM_PROMPT="Você é o clone digital de Yan Chagas. Responde direto ao ponto e de forma autêntica."

# Hugging Face (necessário caso utilize modelos restritos da Meta como Llama 3 no Colab / Unsloth)
HF_TOKEN=hf_seu_token_aqui

# Caminhos de dados (opcional para sobrescrever padrões do config.py)
# RAW_DATA_PATH=data/raw/chat.txt
# PROCESSED_DATA_PATH=data/processed/chat_dataset.jsonl

# Weights & Biases (opcional, para tracking de treinamento com Unsloth)
# WANDB_API_KEY=seu_token_wandb_aqui
